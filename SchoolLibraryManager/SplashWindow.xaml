<Window x:Class="SchoolLibraryManager.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="מערכת ניהול ספרייה"
        Width="560"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">
    <Grid Background="Transparent">
        <Border CornerRadius="12"
                Background="#FFFFFF"
                BorderBrush="#E5EAF2"
                BorderThickness="1"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="0"
                                  Opacity="0.18"
                                  Color="#0F172A" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/school_logo.png"
                           Width="160"
                           Height="160"
                           HorizontalAlignment="Center" />
                    <TextBlock Text="תיכון אתגרי העתיד חריש"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1D4F91"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="מקום שטוב לגדול בו"
                               FontSize="13"
                               FontStyle="Italic"
                               Foreground="#555555"
                               Margin="0,2,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            Width="280"
                            Margin="0,20,0,0">
                    <TextBlock Text="טוען נתונים..."
                               FontSize="16"
                               Margin="0,0,0,10"
                               Foreground="#334155"
                               HorizontalAlignment="Center" />
                    <Border CornerRadius="4" Background="#E2E8F0" Padding="0">
                        <ProgressBar IsIndeterminate="True"
                                     Height="7"
                                     Foreground="#2563EB"
                                     Background="Transparent"
                                     BorderThickness="0" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="רח' יקינטון 32, חריש | טלפון: 04-6514568" FontSize="11" Foreground="#777777" HorizontalAlignment="Center" Margin="0,16,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
