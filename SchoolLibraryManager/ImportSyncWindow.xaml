<Window x:Class="SchoolLibraryManager.ImportSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="מרכז ייבוא וסנכרון נתונים (Excel / משו״ב / גזברות)"
        Height="860"
        Width="1480"
        MinWidth="1280"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F5F7FA"
                BorderBrush="#D8DEE6"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <TextBlock Text="מרכז ייבוא וסנכרון נתונים (Excel / משו״ב / גזברות)"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#1F2937" />
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="סנכרון מצבת חניכים (תחילת שנה) 👨‍🎓">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtStudentSyncFile"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True" />

                        <Button Grid.Column="1"
                                Content="בחר קובץ"
                                Height="34"
                                Margin="8,0,0,0"
                                Padding="12,4"
                                Click="BtnBrowseStudentSyncFile_OnClick" />

                        <Button Grid.Column="2"
                                Content="נתח קובץ"
                                Height="34"
                                Margin="8,0,0,0"
                                Padding="12,4"
                                Background="#0F766E"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Click="BtnAnalyzeStudentSync_OnClick" />
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                        <CheckBox x:Name="ChkMarkMissingAsGraduates"
                                  Content="סמן חניכים שאינם בקובץ כ'בוגרים'"
                                  VerticalAlignment="Center"
                                  FontWeight="SemiBold" />

                        <Border Margin="18,0,0,0" Padding="10,6" CornerRadius="8" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="סה&quot;כ חניכים בקובץ" Foreground="#334155" />
                                <TextBlock x:Name="TxtSyncTotalStudents" Text="0" FontSize="20" FontWeight="Bold" Foreground="#1D4ED8" />
                            </StackPanel>
                        </Border>

                        <Border Margin="8,0,0,0" Padding="10,6" CornerRadius="8" Background="#ECFDF5" BorderBrush="#86EFAC" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="יתווספו כחדשים" Foreground="#334155" />
                                <TextBlock x:Name="TxtSyncNewStudents" Text="0" FontSize="20" FontWeight="Bold" Foreground="#15803D" />
                            </StackPanel>
                        </Border>

                        <Border Margin="8,0,0,0" Padding="10,6" CornerRadius="8" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="יעודכנו" Foreground="#334155" />
                                <TextBlock x:Name="TxtSyncUpdatedStudents" Text="0" FontSize="20" FontWeight="Bold" Foreground="#C2410C" />
                            </StackPanel>
                        </Border>

                        <Border Margin="8,0,0,0" Padding="10,6" CornerRadius="8" Background="#F5F3FF" BorderBrush="#C4B5FD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="יועברו לבוגרים" Foreground="#334155" />
                                <TextBlock x:Name="TxtSyncGraduates" Text="0" FontSize="20" FontWeight="Bold" Foreground="#6D28D9" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              x:Name="GridStudentSyncPreview"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
           EnableRowVirtualization="True"
           EnableColumnVirtualization="True"
           VirtualizingPanel.IsVirtualizing="True"
           VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ת.ז" Binding="{Binding StuId}" Width="*" />
                            <DataGridTextColumn Header="שם פרטי" Binding="{Binding FirstName}" Width="*" />
                            <DataGridTextColumn Header="שם משפחה" Binding="{Binding LastName}" Width="*" />
                            <DataGridTextColumn Header="כיתה" Binding="{Binding ClassCode}" Width="*" />
                            <DataGridTextColumn Header="טלפון" Binding="{Binding Phone}" Width="*" />
                            <DataGridTextColumn Header="עיר" Binding="{Binding City}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="3"
                            Content="בצע עדכון מצבת חניכים 🚀"
                            Height="38"
                            Width="260"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Background="#16A34A"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnExecuteStudentSync_OnClick" />
                </Grid>
            </TabItem>

            <TabItem Header="קליטת קובץ משלמים (גזברות) 💳">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtPaymentImportFile"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True" />

                        <Button Grid.Column="1"
                                Content="בחר קובץ"
                                Height="34"
                                Margin="8,0,0,0"
                                Padding="12,4"
                                Click="BtnBrowsePaymentFile_OnClick" />

                        <Button Grid.Column="2"
                                Content="בדוק קובץ תשלומים 🔍"
                                Height="34"
                                Margin="8,0,0,0"
                                Padding="12,4"
                                Background="#0F766E"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Click="BtnPreviewPaymentImport_OnClick" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,10,0,10"
                            Padding="10"
                            CornerRadius="8"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="חוקי עבודה קריטיים:"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="1. סטטוס בינארי בלבד: שולם / לא שולם / פטור." />
                            <TextBlock Text="2. חניך פטור (stuCriteriaStatus) תמיד מוגן ולא נדרס." />
                            <TextBlock Text="3. ייבוא מצטבר: חניך שכבר שילם בגל קודם נשאר מסומן כשילם." />
                            <TextBlock Text="4. משלמים שאינם במסד הנתונים יתווספו אוטומטית כחניכים חדשים לכיתה 'אחר'." />
                            <TextBlock Text="5. מעבר שנה: לפני קליטת קובץ ראשון לשנת לימודים חדשה, חובה לגשת ללשונית &quot;תקינות ושלמות מסד&quot; ולבצע פתיחת שנת לימודים חדשה." />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,8,0" Padding="10" CornerRadius="8" Background="#ECFDF5" BorderBrush="#86EFAC" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="יסומנו עכשיו כשילמו" Foreground="#334155" />
                                <TextBlock x:Name="TxtPayReadyToMark" Text="0" FontSize="22" FontWeight="Bold" Foreground="#15803D" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="0,0,8,0" Padding="10" CornerRadius="8" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="כבר שילמו בעבר" Foreground="#334155" />
                                <TextBlock x:Name="TxtPayAlreadyPaid" Text="0" FontSize="22" FontWeight="Bold" Foreground="#2563EB" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Margin="0,0,8,0" Padding="10" CornerRadius="8" Background="#F5F3FF" BorderBrush="#C4B5FD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="בעלי פטור מתשלום" Foreground="#334155" />
                                <TextBlock x:Name="TxtPayExempt" Text="0" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Padding="10" CornerRadius="8" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="חניכים חדשים שיצטרפו למאגר" Foreground="#334155" />
                                <TextBlock x:Name="TxtPayUnknown" Text="0" FontSize="22" FontWeight="Bold" Foreground="#475569" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="3"
                              x:Name="GridUnknownPaymentIds"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
           EnableRowVirtualization="True"
           EnableColumnVirtualization="True"
           VirtualizingPanel.IsVirtualizing="True"
           VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="תעודות זהות חדשות שיווספו למאגר כחניכים חדשים" Binding="{Binding UnknownId}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left">
                        <Button Content="אשר וסמן משלמים במערכת ✅"
                                Height="38"
                                Width="280"
                                HorizontalAlignment="Left"
                                Background="#16A34A"
                                Foreground="White"
                                FontWeight="Bold"
                                Click="BtnExecutePaymentImport_OnClick" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="תקינות ושלמות מסד 🛡️">
                <Grid Margin="6" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="הרץ בדיקת שלמות מסד נתונים 🔍"
                                Width="280"
                                Height="34"
                                HorizontalAlignment="Left"
                                Background="#0F766E"
                                Foreground="White"
                                FontWeight="SemiBold"
                                x:Name="BtnRunHealthCheck" Click="BtnRunHealthCheck_OnClick" />
                        <Button Content="גבה מסד נתונים עכשיו 💾"
                                Width="220"
                                Height="34"
                                Margin="8,0,0,0"
                                Background="#4338CA"
                                Foreground="White"
                                FontWeight="SemiBold"
                                x:Name="BtnBackupNow" Click="BtnBackupNow_OnClick" />

						<Button Content="שחזור מסד נתונים ♻️"
								Width="220"
								Height="34"
								Margin="8,0,0,0"
								Background="#B91C1C"
								Foreground="White"
								FontWeight="SemiBold"
								x:Name="BtnRestoreDatabase" Click="BtnRestoreDatabase_OnClick" />

						<Button Content="דחיסה ומיטוב מסד נתונים"
								Height="34"
								Padding="14,4"
								Margin="8,0,0,0"
								Background="#1D4ED8"
								Foreground="White"
								FontWeight="SemiBold"
								Click="BtnCompactDatabase_OnClick" />

						<Button Content="פתח שנת לימודים חדשה"
								Height="34"
								Padding="14,4"
								Margin="8,0,0,0"
								Background="#7C3AED"
								Foreground="White"
								FontWeight="SemiBold"
								x:Name="BtnRolloverSchoolYear" Click="BtnRolloverSchoolYear_OnClick" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                    <Border x:Name="RestoreDatabasePanel" Visibility="Collapsed" FlowDirection="RightToLeft"
                            Margin="0,10,0,0" Padding="12" CornerRadius="8" Background="#FFFBEB"
                            BorderBrush="#F59E0B" BorderThickness="1.5">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="בחירת גיבוי לשחזור מסד הנתונים" FontSize="16" FontWeight="Bold" Foreground="#B91C1C" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                <ComboBox x:Name="CmbBackupFilter" Width="220" SelectedIndex="0" SelectionChanged="CmbBackupFilter_OnSelectionChanged">
                                    <ComboBoxItem Content="כל הגיבויים" />
                                    <ComboBoxItem Content="גיבוי ידני" />
                                    <ComboBoxItem Content="גיבוי אוטומטי (הפעלה/סגירה)" />
                                    <ComboBoxItem Content="גיבוי תחזוקה/חירום" />
                                </ComboBox>
                                <Button x:Name="BtnRefreshBackups" Content="רענן רשימה" Margin="8,0,0,0" Padding="12,4" Click="BtnRefreshBackups_OnClick" />
                                <Button x:Name="BtnBrowseExternalBackup" Content="בחר קובץ מתיקייה חיצונית..." Margin="8,0,0,0" Padding="12,4" Click="BtnBrowseExternalBackup_OnClick" />
                            </StackPanel>
                            <DataGrid x:Name="DgAvailableBackups" Height="220" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" HeadersVisibility="Column"
                                      FlowDirection="RightToLeft" EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      SelectionChanged="DgAvailableBackups_OnSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="תאריך ושעה" Binding="{Binding DateText}" Width="230" />
                                    <DataGridTextColumn Header="סוג גיבוי" Binding="{Binding TypeText}" Width="230" />
                                    <DataGridTextColumn Header="גודל קובץ" Binding="{Binding SizeText}" Width="100" />
                                    <DataGridTextColumn Header="שם הקובץ" Binding="{Binding FileName}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Margin="0,8,0,8" TextWrapping="Wrap" Foreground="#92400E"
                                       Text="⚠️ שים לב: שחזור מסד הנתונים יחליף את הנתונים הנוכחיים בקובץ הגיבוי הנבחר. המערכת תייצר גיבוי חירום אוטומטי של המצב הנוכחי לפני ביצוע השחזור." />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnConfirmRestore" Content="בצע שחזור לגיבוי המסומן" IsEnabled="False" Padding="14,6"
                                        Background="#B91C1C" Foreground="White" FontWeight="SemiBold" Click="BtnConfirmRestore_OnClick" />
                                <Button x:Name="BtnCancelRestore" Content="ביטול / סגור" Margin="8,0,0,0" Padding="14,6" Click="BtnCancelRestore_OnClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,8,0" Padding="10" CornerRadius="8" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="סה&quot;כ כותרים" Foreground="#334155" />
                                <TextBlock x:Name="TxtHealthTotalBooks" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1D4ED8" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="0,0,8,0" Padding="10" CornerRadius="8" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="סה&quot;כ עותקים" Foreground="#334155" />
                                <TextBlock x:Name="TxtHealthTotalCopies" Text="0" FontSize="22" FontWeight="Bold" Foreground="#15803D" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Margin="0,0,8,0" Padding="10" CornerRadius="8" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="סה&quot;כ חניכים" Foreground="#334155" />
                                <TextBlock x:Name="TxtHealthTotalStudents" Text="0" FontSize="22" FontWeight="Bold" Foreground="#C2410C" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Margin="0,0,8,0" Padding="10" CornerRadius="8" Background="#F5F3FF" BorderBrush="#C4B5FD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="השאלות פעילות" Foreground="#334155" />
                                <TextBlock x:Name="TxtHealthActiveLoans" Text="0" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Padding="10" CornerRadius="8" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="רשומות היסטוריה" Foreground="#334155" />
                                <TextBlock x:Name="TxtHealthHistoryRecords" Text="0" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Background="White">
<Grid HorizontalAlignment="Stretch">
<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Stretch">
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
<TextBlock Grid.Column="0" Text="התראות תקינות" FontWeight="Bold" VerticalAlignment="Center" />
</Grid>
                                <ListBox Grid.Row="1" HorizontalAlignment="Stretch" x:Name="LstHealthWarnings" BorderThickness="0" Background="Transparent" MaxHeight="120">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" Foreground="{Binding Foreground}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
</Grid>
                        </Border>

                        <Border x:Name="AnomalousLoansSection" VerticalAlignment="Stretch" Visibility="Collapsed" Grid.Row="1" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Background="White">
                            <Grid VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

<Grid Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Stretch">
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="השאלות פעילות חריגות הדורשות טיפול" FontWeight="Bold" VerticalAlignment="Center" />
                                <Button x:Name="BtnAutoCleanMissingBarcodeLoans" Cursor="Hand" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" Padding="14,7" Background="#D97706" Foreground="White" FontWeight="Bold" BorderThickness="0" Visibility="Collapsed" Content="&#x26A1; &#x05E0;&#x05E7;&#x05D4; &#x05D0;&#x05D5;&#x05D8;&#x05D5;&#x05DE;&#x05D8;&#x05D9;&#x05EA; &#x05D4;&#x05E9;&#x05D0;&#x05DC;&#x05D5;&#x05EA; &#x05D7;&#x05E8;&#x05D9;&#x05D2;&#x05D5;&#x05EA;" Click="BtnAutoCleanMissingBarcodeLoans_OnClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="#92400E" BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="6" ShadowDepth="2" />
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#B45309" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#78350F" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#92400E" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
</Grid>

                                <Grid Grid.Row="1">
                                    <TextBlock x:Name="TxtBrokenLoansOk" Text="לא נמצאו השאלות חריגות. הכול תקין." Foreground="#16A34A" FontWeight="SemiBold" Visibility="Collapsed" VerticalAlignment="Top" />

                                    <DataGrid x:Name="GridBrokenLoans" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" AutoGenerateColumns="False"
           EnableRowVirtualization="True"
           EnableColumnVirtualization="True"
           VirtualizingPanel.IsVirtualizing="True"
           VirtualizingPanel.VirtualizationMode="Recycling">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ברקוד" Binding="{Binding Barcode}" Width="*" />
                                            <DataGridTextColumn Header="ת.ז" Binding="{Binding stuID}" Width="*" />
                                            <DataGridTextColumn Header="חניך" Binding="{Binding StudentName}" Width="2*" />
                                            <DataGridTextColumn Header="כיתה" Binding="{Binding ClassName}" Width="*" />
                                            <DataGridTextColumn Header="תאריך השאלה" Binding="{Binding LoanDate}" Width="*" />
                                            <DataGridTextColumn Header="סיבת חריגה" Binding="{Binding Reason}" Width="2*" />
                                            <DataGridTemplateColumn Header="פעולה" Width="190">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="נקה / סגור השאלה" Padding="8,2" CommandParameter="{Binding}" Click="BtnResolveBrokenLoan_OnClick" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10,6"
                CornerRadius="6"
                Background="#1D4ED8">
            <TextBlock x:Name="TxtStatus"
                       Text="מוכן"
                       Foreground="White"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
