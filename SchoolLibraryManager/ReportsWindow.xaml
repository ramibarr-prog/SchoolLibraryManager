<Window x:Class="SchoolLibraryManager.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="מרכז דוחות וסטטיסטיקה"
        Height="820"
        Width="1400"
        MinWidth="1200"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F5F7FA"
                BorderBrush="#D8DEE6"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <TextBlock Text="מרכז דוחות וסטטיסטיקה"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#1F2937" />
        </Border>

        <TabControl Grid.Row="1" x:Name="TabsReports">
            <TabItem Header="ספרים באיחור ⏰">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="סינון לפי כיתה:"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,8,0" />
                        <ComboBox x:Name="CmbOverdueClass"
                                  Width="180"
                                  Height="32"
                                  DisplayMemberPath="ClassName"
                                  SelectedValuePath="ClassID" />
                        <Button Content="רענן דוח"
                                Width="110"
                                Height="32"
                                Margin="8,0,0,0"
                                Click="BtnRefreshOverdue_OnClick" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="GridOverdue"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
           EnableRowVirtualization="True"
           EnableColumnVirtualization="True"
           VirtualizingPanel.IsVirtualizing="True"
           VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ברקוד" Binding="{Binding Barcode}" Width="*" />
                            <DataGridTextColumn Header="שם הספר" Binding="{Binding BookTitle}" Width="2*" />
                            <DataGridTextColumn Header="שם החניך" Binding="{Binding StudentName}" Width="2*" />
                            <DataGridTextColumn Header="כיתה" Binding="{Binding ClassName}" Width="*" />
                            <DataGridTextColumn Header="טלפון" Binding="{Binding stuPhone}" Width="*" />
                            <DataGridTextColumn Header="תאריך השאלה" Binding="{Binding LoanDate}" Width="*" />
                            <DataGridTextColumn Header="תאריך יעד" Binding="{Binding DueDate}" Width="*" />
                            <DataGridTemplateColumn Header="ימי איחור" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DaysOverdue}"
                                                   Foreground="#DC2626"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2"
                            Content="הדפס דוח איחורים / פתקי תזכורת 🖨️"
                            Height="34"
                            Width="300"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Background="#1D4ED8"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="BtnPrintOverdue_OnClick" />
                </Grid>
            </TabItem>

            <TabItem Header="מלאי ספרייה 📊">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,8,0" Padding="10" CornerRadius="8" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="סה&quot;כ כותרים במאגר" Foreground="#334155" />
                                <TextBlock x:Name="TxtKpiTotalTitles" Text="0" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="0,0,8,0" Padding="10" CornerRadius="8" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="סה&quot;כ עותקים פיזיים" Foreground="#334155" />
                                <TextBlock x:Name="TxtKpiTotalCopies" Text="0" FontSize="24" FontWeight="Bold" Foreground="#065F46" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Margin="0,0,8,0" Padding="10" CornerRadius="8" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="עותקים בהשאלה פעילה" Foreground="#334155" />
                                <TextBlock x:Name="TxtKpiActiveLoans" Text="0" FontSize="24" FontWeight="Bold" Foreground="#9A3412" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Padding="10" CornerRadius="8" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="עותקים זמינים על המדף" Foreground="#334155" />
                                <TextBlock x:Name="TxtKpiAvailableCopies" Text="0" FontSize="24" FontWeight="Bold" Foreground="#1D4ED8" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              x:Name="GridInventoryBySubject"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
           EnableRowVirtualization="True"
           EnableColumnVirtualization="True"
           VirtualizingPanel.IsVirtualizing="True"
           VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="מקצוע" Binding="{Binding SubjectName}" Width="2*" />
                            <DataGridTextColumn Header="כמות כותרים" Binding="{Binding TitlesCount}" Width="*" />
                            <DataGridTextColumn Header="כמות עותקים" Binding="{Binding CopiesCount}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="מעקב גבייה 💰">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="סינון לפי כיתה:"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,8,0" />
                        <ComboBox x:Name="CmbUnpaidClass"
                                  Width="180"
                                  Height="32"
                                  DisplayMemberPath="ClassName"
                                  SelectedValuePath="ClassID" />
                        <Button Content="רענן"
                                Width="100"
                                Height="32"
                                Margin="8,0,0,0"
                                Click="BtnRefreshUnpaid_OnClick" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               x:Name="TxtUnpaidTitle"
                               Text="חניכים שטרם שילמו דמי ספרייה לשנה הנוכחית"
                               FontWeight="Bold"
                               Margin="0,0,0,8" />

                    <DataGrid Grid.Row="2"
                              x:Name="GridUnpaidStudents"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
           EnableRowVirtualization="True"
           EnableColumnVirtualization="True"
           VirtualizingPanel.IsVirtualizing="True"
           VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ת.ז" Binding="{Binding stuID}" Width="*" />
                            <DataGridTextColumn Header="שם מלא" Binding="{Binding FullName}" Width="2*" />
                            <DataGridTextColumn Header="כיתה" Binding="{Binding ClassName}" Width="*" />
                            <DataGridTextColumn Header="טלפון" Binding="{Binding stuPhone}" Width="*" />
                            <DataGridTextColumn Header="השאלות פעילות" Binding="{Binding ActiveLoansCount}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="3"
                            Content="הדפס רשימת חובות 🖨️"
                            Height="34"
                            Width="210"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Background="#1D4ED8"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="BtnPrintUnpaid_OnClick" />
                </Grid>
            </TabItem>

            <TabItem Header="השאלות פעילות 📚">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="סינון לפי כיתה:"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,8,0" />
                        <ComboBox x:Name="CmbActiveLoansClass"
                                  Width="180"
                                  Height="32"
                                  DisplayMemberPath="ClassName"
                                  SelectedValuePath="ClassID" />
                        <Button Content="רענן דוח"
                                Width="110"
                                Height="32"
                                Margin="8,0,0,0"
                                Click="BtnRefreshActiveLoans_OnClick" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="GridActiveLoans"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="כיתה" Binding="{Binding ClassName}" Width="*" />
                            <DataGridTextColumn Header="שם החניך" Binding="{Binding StudentName}" Width="2*" />
                            <DataGridTextColumn Header="טלפון" Binding="{Binding stuPhone}" Width="*" />
                            <DataGridTextColumn Header="שם הספר" Binding="{Binding BookTitle}" Width="2*" />
                            <DataGridTextColumn Header="ברקוד" Binding="{Binding Barcode}" Width="*" />
                            <DataGridTextColumn Header="תאריך השאלה" Binding="{Binding LoanDate}" Width="*" />
                            <DataGridTextColumn Header="תאריך החזרה" Binding="{Binding DueDate}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2"
                            Content="הדפס השאלות פעילות 🖨️"
                            Height="34"
                            Width="240"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Background="#1D4ED8"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="BtnPrintActiveLoans_OnClick" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10,6"
                CornerRadius="6"
                Background="#1D4ED8">
            <TextBlock x:Name="TxtStatus"
                       Text="מוכן"
                       Foreground="White"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
