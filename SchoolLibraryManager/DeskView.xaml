<UserControl x:Class="SchoolLibraryManager.DeskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             PreviewMouseDown="DeskView_OnPreviewMouseDown"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F5F7FA"
                BorderBrush="#D8DEE6"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="איתור חניך (שם מלא / ת.ז):"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="txtStudentSearch"
                             Width="260"
                             Height="34"
                             VerticalContentAlignment="Center"
                             TextAlignment="Right"
                              TextChanged="TxtStudentSearch_OnTextChanged"
                             KeyDown="TxtStudentSearch_OnKeyDown" />
                    <Button Content="חפש"
                            Width="90"
                            Height="34"
                            Margin="8,0,0,0"
                            Click="BtnSearchStudent_OnClick" />
                </StackPanel>

                <Popup x:Name="popupStudentSuggestions"
                       PlacementTarget="{Binding ElementName=txtStudentSearch}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Width="430"
                            Margin="0,4,0,0"
                            Background="White"
                            BorderBrush="#D8DEE6"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                        <ListBox x:Name="lstStudentSuggestions"
                                 MaxHeight="300"
                                 BorderThickness="0"
                                 PreviewMouseLeftButtonUp="LstStudentSuggestions_OnPreviewMouseLeftButtonUp"
                                 KeyDown="LstStudentSuggestions_OnKeyDown"
                                 DisplayMemberPath="DisplayText" />
                    </Border>
                </Popup>

                <TextBlock Grid.Column="1"
                           Text="דלפק השאלות והחזרות"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>

        <Border x:Name="studentCardPanel"
                Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#D8DEE6"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="ת.ז" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="txtStuId" IsReadOnly="True" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="שם פרטי" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="txtFirstName" IsReadOnly="True" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                    <TextBlock Text="שם משפחה" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="txtLastName" IsReadOnly="True" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                    <TextBlock Text="כיתה" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="txtClass" IsReadOnly="True" />
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="8,0,0,0" HorizontalAlignment="Stretch">
                    <TextBlock Text="תשלום לשנה נוכחית" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="paymentBadge"
                                Margin="0,0,8,0"
                                Padding="10,6"
                                CornerRadius="6"
                                Visibility="Collapsed"
                                Background="#DC2626">
                            <TextBlock x:Name="txtPaymentStatus"
                                       Text="לא שולם"
                                       Foreground="White"
                                       FontWeight="SemiBold" />
                        </Border>
                        <CheckBox x:Name="chkAllowOneTimeBorrow"
                                  Content="אישור השאלה חריג"
                                  ToolTip="מאפשר השאלת ספר לחניך הנוכחי באופן חד-פעמי, מבלי לשנות את סטטוס התשלום השנתי שלו במסד הנתונים."
                                  VerticalAlignment="Center"
                                  Checked="ChkAllowOneTimeBorrow_OnChanged"
                                  Unchecked="ChkAllowOneTimeBorrow_OnChanged" />
                    </StackPanel>
                    <Border x:Name="borderOverdueWarning"
                            Margin="0,8,0,0"
                            Padding="10"
                            CornerRadius="4"
                            Background="Red"
                            HorizontalAlignment="Stretch"
                            Visibility="Collapsed">
                        <TextBlock Text="⚠️ שים לב! לחניך זה יש ספרים באיחור!"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="5" Margin="12,20,0,0">
                    <Border x:Name="statusBadge"
                            Margin="0,0,0,8"
                            Padding="10,6"
                            CornerRadius="6"
                            Background="#1D4ED8">
                        <TextBlock x:Name="txtStatus"
                                   Text="מוכן"
                                   Foreground="White"
                                   FontWeight="SemiBold" />
                    </Border>
                    <Button x:Name="btnPrintActiveLoans"
                            Content="הדפס פירוט השאלות"
                            Height="30"
                            Padding="10,4"
                            Click="BtnPrintActiveLoans_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D8DEE6"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtActiveLoansHeader"
                               Grid.Row="0"
                               Text="השאלות פעילות"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,8" />

                    <TextBlock x:Name="txtQuickReturnLogHeader"
                               Grid.Row="0"
                               Text="ספרים שהוחזרו בסבב זה"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,8"
                               Visibility="Collapsed" />

                    <DataGrid Grid.Row="1"
                              x:Name="dgActiveLoans"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              Margin="0,4,0,0"
                              MouseDoubleClick="DgActiveLoans_MouseDoubleClick"
           EnableRowVirtualization="True"
           EnableColumnVirtualization="True"
           VirtualizingPanel.IsVirtualizing="True"
           VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverdue}" Value="1">
                                        <Setter Property="Background" Value="#FFCDD2" />
                                        <Setter Property="Foreground" Value="#991B1B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ברקוד" Binding="{Binding Barcode}" Width="*" />
                            <DataGridTextColumn Header="כותר" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="תאריך השאלה" Binding="{Binding DateBorrowed, StringFormat={}{0:dd/MM/yyyy}}" Width="*" />
                            <DataGridTextColumn Header="תאריך החזרה" Binding="{Binding DateToReturn, StringFormat={}{0:dd/MM/yyyy}}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Row="1"
                              x:Name="gridSessionReturns"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              Margin="0,4,0,0"
                              Visibility="Collapsed"
           EnableRowVirtualization="True"
           EnableColumnVirtualization="True"
           VirtualizingPanel.IsVirtualizing="True"
           VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="שעה" Binding="{Binding ReturnTime}" Width="*" />
                            <DataGridTextColumn Header="ברקוד" Binding="{Binding Barcode}" Width="*" />
                            <DataGridTextColumn Header="כותר" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="חניך" Binding="{Binding StudentName}" Width="2*" />
                            <DataGridTextColumn Header="כיתה" Binding="{Binding ClassName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#D8DEE6"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Visibility="Visible">
                    <TabControl x:Name="tabDeskActions"
                                SelectionChanged="TabDeskActions_OnSelectionChanged">
                            <TabItem Header="השאלה">
                                <Border x:Name="PanelBorrow"
                                        Background="#F8FAFC"
                                        BorderBrush="#D8DEE6"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0">
                                            <TextBlock Text="פאנל השאלה" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                                            <TextBlock Text="ברקוד עותק" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <TextBox x:Name="txtBorrowBarcode"
                                                     Height="36"
                                                     VerticalContentAlignment="Center"
                                                     KeyDown="TxtBorrowBarcode_OnKeyDown" />
                                            <Button x:Name="btnBorrow"
                                                    Content="➕ הוסף לעגלת השאלה"
                                                    Margin="0,8,0,0"
                                                    Height="34"
                                                    Click="BtnBorrow_OnClick" />
                                        </StackPanel>

                                        <DataGrid Grid.Row="1"
                                                  x:Name="dgBorrowCart"
                                                  Margin="0,8,0,8"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  RowHeaderWidth="0"
                                                  MinHeight="120"
           EnableRowVirtualization="True"
           EnableColumnVirtualization="True"
           VirtualizingPanel.IsVirtualizing="True"
           VirtualizingPanel.VirtualizationMode="Recycling">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, Mode=TwoWay}" Width="36" />
                                                <DataGridTextColumn Header="ברקוד" Binding="{Binding Barcode}" Width="*" />
                                                <DataGridTextColumn Header="כותר" Binding="{Binding Title}" Width="2*" />
                                                <DataGridTemplateColumn Header="" Width="72">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="הסר"
                                                                    Height="26"
                                                                    Background="#DC2626"
                                                                    Foreground="White"
                                                                    BorderBrush="#B91C1C"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Padding="8,2"
                                                                    Click="BtnRemoveBorrowCartItem_OnClick" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Button Grid.Row="2"
                                                x:Name="btnBorrowExecute"
                                                Content="בצע השאלה למסומנים"
                                                Height="40"
                                                Background="#16A34A"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                HorizontalAlignment="Stretch"
                                                Click="BtnBorrowExecute_OnClick" />
                                    </Grid>
                                </Border>
                            </TabItem>

                            <TabItem Header="החזרה">
                                <Border x:Name="PanelManualReturn"
                                        Background="#F8FAFC"
                                        BorderBrush="#D8DEE6"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0">
                                            <TextBlock Text="פאנל החזרה" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                                            <TextBlock Text="ברקוד עותק" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <TextBox x:Name="txtManualReturnBarcode"
                                                     Height="36"
                                                     VerticalContentAlignment="Center"
                                                     KeyDown="TxtManualReturnBarcode_OnKeyDown" />
                                            <Button x:Name="btnReturnSingle"
                                                    Content="➕ הוסף לעגלת החזרה"
                                                    Margin="0,8,0,0"
                                                    Height="34"
                                                    Click="BtnReturnSingle_OnClick" />
                                        </StackPanel>

                                        <DataGrid Grid.Row="1"
                                                  x:Name="dgReturnCart"
                                                  Margin="0,8,0,8"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  RowHeaderWidth="0"
                                                  MinHeight="120"
           EnableRowVirtualization="True"
           EnableColumnVirtualization="True"
           VirtualizingPanel.IsVirtualizing="True"
           VirtualizingPanel.VirtualizationMode="Recycling">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, Mode=TwoWay}" Width="36" />
                                                <DataGridTextColumn Header="ברקוד" Binding="{Binding Barcode}" Width="*" />
                                                <DataGridTextColumn Header="כותר" Binding="{Binding Title}" Width="2*" />
                                                <DataGridTextColumn Header="שם השואל המקורי" Binding="{Binding BorrowerName}" Width="2*" />
                                                <DataGridTemplateColumn Header="" Width="72">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="הסר"
                                                                    Height="26"
                                                                    Background="#DC2626"
                                                                    Foreground="White"
                                                                    BorderBrush="#B91C1C"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Padding="8,2"
                                                                    Click="BtnRemoveReturnCartItem_OnClick" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Button Grid.Row="2"
                                                x:Name="btnReturnExecute"
                                                Content="בצע החזרה למסומנים"
                                                Height="40"
                                                Background="#16A34A"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                HorizontalAlignment="Stretch"
                                                Click="BtnReturnExecute_OnClick" />
                                    </Grid>
                                </Border>
                            </TabItem>
                            <TabItem Header="החזרה מהירה">
                                <Border Background="#F0FDF4"
                                        BorderBrush="#16A34A"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="4">
                                    <StackPanel>
                                        <TextBlock x:Name="quickReturnBadge"
                                                   Text="🟢 מצב החזרות מהיר פעיל"
                                                   Foreground="#14532D"
                                                   FontWeight="Bold"
                                                   FontSize="18"
                                                   Margin="0,0,0,10" />
                                        <TextBox x:Name="txtQuickReturnBarcode"
                                                 Height="46"
                                                 FontSize="18"
                                                 VerticalContentAlignment="Center"
                                                 KeyDown="TxtQuickReturnBarcode_OnKeyDown" />
                                        <Button x:Name="btnReturn"
                                                Content="החזר עותק"
                                                Margin="0,10,0,0"
                                                Height="38"
                                                Click="BtnReturn_OnClick" />
                                    </StackPanel>
                                </Border>
                            </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
