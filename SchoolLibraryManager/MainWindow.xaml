<Window x:Class="SchoolLibraryManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ספריית תיכון אתגרי העתיד חריש - מערכת ניהול ספרייה"
        Icon="/Assets/school_logo.png"
        Height="800"
        Width="1280"
        MinWidth="1024"
        MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                    <Setter Property="BorderBrush" Value="#1E3A8A" />
                    <Setter Property="Foreground" Value="#1E3A8A" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#D8DEE6" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Image Source="/Assets/school_logo.png" Width="36" Height="36" Margin="0,0,0,0" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ספריית תיכון אתגרי העתיד" FontWeight="Bold" FontSize="16" Foreground="#1D4F91" />
                        <TextBlock Text="מקום שטוב לגדול בו" FontSize="11" Foreground="#666666" />
                    </StackPanel>
                </StackPanel>

                <WrapPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" ItemHeight="38">
                    <ToggleButton x:Name="BtnNavDesk" Content="דלפק השאלות ⚡" Margin="0,0,10,0" Padding="14,6" Click="NavButton_OnClick" Tag="Desk" />
                    <ToggleButton x:Name="BtnNavBooks" Content="כותרים ועותקים 📖" Margin="0,0,10,0" Padding="14,6" Click="NavButton_OnClick" Tag="Books" />
                    <ToggleButton x:Name="BtnNavStudents" Content="חניכים ותשלומים 👨‍🎓" Margin="0,0,10,0" Padding="14,6" Click="NavButton_OnClick" Tag="Students" />
                    <ToggleButton x:Name="BtnNavReports" Content="דוחות וסטטיסטיקה 📊" Margin="0,0,10,0" Padding="14,6" Click="NavButton_OnClick" Tag="Reports" />
                    <ToggleButton x:Name="BtnNavImport" Content="ייבוא וסנכרון 📥" Padding="14,6" Click="NavButton_OnClick" Tag="Import" />
                </WrapPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="גיבוי מהיר 💾" Padding="12,6" Click="BtnQuickBackup_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="8" Background="#F8FAFC">
            <ContentControl x:Name="MainContentHost" />
        </Border>

        <Border Grid.Row="2" Background="#1E3A8A" Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="TxtShellStatus" DockPanel.Dock="Left" Text="מוכן" Foreground="White" FontWeight="SemiBold" />
                <TextBlock x:Name="txtShortcutsHelp"
                           DockPanel.Dock="Right"
                           Text="[F2] חניך | [F3] ברקוד ספר | [F4] החזרה מהירה | [Esc] איפוס דלפק"
                           Foreground="#DBEAFE"
                           FontSize="11" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
